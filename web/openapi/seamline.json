  "components": {
    "schemas": {
      "AmendTradeRequest": {
        "required": [
          "volume",
          "price",
          "reason"
        ],
        "type": "object",
        "properties": {
          "volume": {
            "type": "number",
            "format": "double"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "AuditEventEntry": {
        "required": [
          "id",
          "occurredAt",
          "actor",
          "action",
          "entityType",
          "entityId",
          "context"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
