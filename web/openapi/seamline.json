        "type": "object",
        "properties": {
          "counterpartyId": {
            "type": "string",
            "format": "uuid"
          },
          "creditLimit": {
            "type": "number",
            "format": "double"
          },
          "currentExposure": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CounterpartyRef": {
        "required": [
          "id",
          "name",
          "creditLimit"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "creditLimit": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CreateCounterpartyRequest": {
        "required": [
          "name",
          "creditLimit"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "creditLimit": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CreateTradeRequest": {
        "required": [
          "commodityCode",
          "deliveryPeriod",
          "direction",
          "volume",
          "price",
          "counterpartyId"
        ],
        "type": "object",
        "properties": {
          "commodityCode": {
            "type": "string"
          },
          "deliveryPeriod": {
            "type": "string"
          },
          "direction": {
            "$ref": "#/components/schemas/TradeDirection"
          },
          "volume": {
            "type": "number",
            "format": "double"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "counterpartyId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreditReservationOutcome": {
        "enum": [
          "Reserved",
          "Breached"
        ]
      },
      "CurvePointEntry": {
        "required": [
          "commodityCode",
          "deliveryPeriod",
          "price",
          "publishedAt"
        ],
        "type": "object",
        "properties": {
          "commodityCode": {
            "type": "string"
          },
          "deliveryPeriod": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "error"
