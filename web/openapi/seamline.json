      "PositionRef": {
        "required": [
          "commodityCode",
          "deliveryPeriod",
          "netVolume",
          "weightedAvgPrice",
          "markPrice",
          "mtmAmount"
        ],
        "type": "object",
        "properties": {
          "commodityCode": {
            "type": "string"
          },
          "deliveryPeriod": {
            "type": "string"
          },
          "netVolume": {
            "type": "number",
            "format": "double"
          },
          "weightedAvgPrice": {
            "type": "number",
            "format": "double"
