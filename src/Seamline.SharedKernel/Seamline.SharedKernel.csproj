<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- PrivateAssets="all" so this doesn't flow to Contracts projects that
         reference SharedKernel — they have no use for EF Core, and
         ContractsBoundaryTests expects "depends only on SharedKernel" to
         mean plain DTOs, not a transitive EF Core dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
