          "markPrice": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "mtmAmount": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "PositionsResponse": {
        "required": [
