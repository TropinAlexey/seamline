<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Seamline.Modules.Identity.Contracts\Seamline.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Seamline.SharedKernel\Seamline.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Domain logic (PasswordHasher, JwtTokenFactory) is internal by
         design (see Seamline.ArchTests.InternalVisibilityTests). Grants
         friend access instead of a public API — same pattern as
         Trading/Risk's InternalsVisibleTo for their own *.Tests projects.
         IntegrationTests gets it too so AuthTestHelper can call the real
         PasswordHasher.Hash instead of re-deriving its format as separate
         literals that could silently drift out of sync. -->
    <InternalsVisibleTo Include="Seamline.IntegrationTests" />
    <InternalsVisibleTo Include="Seamline.Modules.Identity.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Seamline.Modules.Identity.Internal</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
